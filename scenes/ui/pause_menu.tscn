[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/ui/pause_menu.gd" id="1_pause"]
[ext_resource type="PackedScene" path="res://scenes/ui/settings_panel.tscn" id="2_settings"]
[ext_resource type="Theme" path="res://data/ui/interface_theme.tres" id="3_theme"]
[ext_resource type="Script" path="res://scripts/ui/accent_panel.gd" id="4_accent"]

[node name="PauseMenu" type="CanvasLayer"]
process_mode = 3
layer = 100
script = ExtResource("1_pause")

[node name="Overlay" type="Control" parent="."]
unique_name_in_owner = true
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("3_theme")

[node name="Dimmer" type="ColorRect" parent="Overlay"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.0117647, 0.0235294, 0.0392157, 0.82)

[node name="Panel" type="Panel" parent="Overlay"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -190.0
offset_top = -195.0
offset_right = 190.0
offset_bottom = 195.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("4_accent")
accent_width = 6.0

[node name="Menu" type="VBoxContainer" parent="Overlay/Panel"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 36.0
offset_top = 30.0
offset_right = -36.0
offset_bottom = -30.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Overlay/Panel/Menu"]
layout_mode = 2
theme_type_variation = &"ScreenTitle"
text = "PAUSED"
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="Overlay/Panel/Menu"]
custom_minimum_size = Vector2(0, 14)
layout_mode = 2
mouse_filter = 2

[node name="ResumeButton" type="Button" parent="Overlay/Panel/Menu"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 50)
layout_mode = 2
theme_type_variation = &"ArtButton"
theme_override_font_sizes/font_size = 19
text = "RESUME"

[node name="RestartButton" type="Button" parent="Overlay/Panel/Menu"]
custom_minimum_size = Vector2(0, 46)
layout_mode = 2
theme_type_variation = &"ArtButton"
theme_override_font_sizes/font_size = 17
text = "RESTART"

[node name="SettingsButton" type="Button" parent="Overlay/Panel/Menu"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 46)
layout_mode = 2
theme_type_variation = &"ArtButton"
theme_override_font_sizes/font_size = 17
text = "SETTINGS"

[node name="MainMenuButton" type="Button" parent="Overlay/Panel/Menu"]
custom_minimum_size = Vector2(0, 46)
layout_mode = 2
theme_type_variation = &"ArtButton"
theme_override_font_sizes/font_size = 17
text = "MAIN MENU"

[node name="Hint" type="Label" parent="Overlay/Panel/Menu"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "ESC TO RESUME"
horizontal_alignment = 1

[node name="SettingsPanel" parent="." instance=ExtResource("2_settings")]

[connection signal="pressed" from="Overlay/Panel/Menu/ResumeButton" to="." method="_on_resume_pressed"]
[connection signal="pressed" from="Overlay/Panel/Menu/RestartButton" to="." method="_on_restart_pressed"]
[connection signal="pressed" from="Overlay/Panel/Menu/SettingsButton" to="." method="_on_settings_pressed"]
[connection signal="pressed" from="Overlay/Panel/Menu/MainMenuButton" to="." method="_on_main_menu_pressed"]
[connection signal="closed" from="SettingsPanel" to="." method="_on_settings_closed"]
