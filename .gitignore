# Allowlist: ignore everything unless explicitly included below.
/*

!/.gitignore
!/.gitattributes
!/.editorconfig
!/project.godot
!/default_bus_layout.tres
!/main.tscn
!/icon.svg
!/README.md
!/assets/
!/assets/**
!/data/
!/data/**
!/scenes/
!/scenes/**
!/scripts/
!/scripts/**

# Godot regenerates importer sidecars and cached imports.
*.import
