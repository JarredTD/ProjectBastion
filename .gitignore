# Allowlist: ignore everything unless explicitly included below.
/*

!/.gitignore
!/.gitattributes
!/.editorconfig
!/.github/
!/.github/workflows/
!/.github/workflows/deploy-pages.yml
!/project.godot
!/export_presets.cfg
!/default_bus_layout.tres
!/main.tscn
!/icon.svg
!/README.md
!/assets/
!/assets/**
!/data/
!/data/**
!/scenes/
!/scenes/**
!/scripts/
!/scripts/**

# Godot regenerates importer sidecars and cached imports.
*.import
